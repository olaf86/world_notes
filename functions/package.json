{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "tsc",
    "build:test": "node -e \"require('node:fs').rmSync('.test-build', { recursive: true, force: true })\" && tsc -p tsconfig.test.json",
    "test": "npm run build:test && node --test .test-build/test/*.test.js",
    "test:firestore-rules": "npm run build:test && npx -y firebase-tools@15.25.1 emulators:exec --config ../firebase.rules-test.json --project demo-world-notes-rules --only firestore,storage \"npm run test:firestore-rules:emulator\"",
    "test:firestore-rules:emulator": "node --test .test-build/test/firestoreRules.test.js .test-build/test/storageRules.test.js",
    "test:functions-emulator": "npm run build && npm run build:test && OPENAI_API_KEY=emulator-test-key NOTE_PW_PEPPER=emulator-test-pepper npx -y firebase-tools@15.25.1 emulators:exec --config ../firebase.functions-test.json --project demo-world-notes-functions --only auth,firestore,functions \"npm run test:functions-emulator:contract\"",
    "test:functions-emulator:contract": "RUN_FUNCTIONS_EMULATOR_TESTS=1 node --test .test-build/test/functionsEmulator.contract.test.js",
    "test:firestore-contract": "npm run build:test && node --test .test-build/test/worldFirestore.contract.test.js",
    "test:firestore-contract:cloud": "npm run build:test && node --test .test-build/test/worldFirestore.contract.test.js",
    "evaluate:moderation": "npm run build && node lib/scripts/evaluateModeration.js",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "admin:set": "npm run build && node lib/scripts/setAdminClaim.js",
    "admin:unset": "npm run build && node lib/scripts/setAdminClaim.js --unset",
    "moderation:test-data": "npm run build && node lib/scripts/moderationTestData.js",
    "preflight:production": "npm run build && node lib/scripts/runProductionPreflight.js",
    "backfill:accounts": "npm run build && node lib/scripts/backfillAccounts.js",
    "backfill:social-edges": "npm run build && node lib/scripts/backfillSocialEdges.js",
    "inventory:activation-data": "npm run build && node lib/scripts/inventoryActivationData.js",
    "smoke:mirror-only-world": "npm run build && node lib/scripts/smokeMirrorOnlyWorld.js",
    "seed:screenshot": "npm run build && node lib/scripts/seedScreenshotData.js",
    "seed:acceptance": "npm run build && node lib/scripts/seedAcceptanceData.js",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "dependencies": {
    "argon2": "^0.44.0",
    "firebase-admin": "13.10.0",
    "firebase-functions": "^7.3.2",
    "libphonenumber-js": "^1.13.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase": "^12.17.0",
    "firebase-functions-test": "^3.4.1",
    "typescript": "^6.0.0"
  },
  "private": true
}
