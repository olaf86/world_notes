platform :ios, '15.0'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. Run flutter pub get first."
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end

  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Run flutter pub get first."
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks! :linkage => :static

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.shell_script_build_phases.each do |build_phase|
      next unless build_phase.name == '[CP] Copy XCFrameworks'

      # CocoaPods writes XCFramework intermediates under Flutter's build/ios
      # directory, which can make Xcode's stale-file cleanup warn that files are
      # outside its allowed roots. Run these copy phases explicitly instead of
      # asking Xcode to track those generated intermediate paths.
      build_phase.input_file_list_paths = []
      build_phase.output_file_list_paths = []
      build_phase.always_out_of_date = '1'
    end

    target.build_configurations.each do |config|
      # Flutter/CocoaPods scripts need to read and write generated files outside
      # each individual Pods target's sandboxed input/output list.
      config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'

      # Keep local `flutter run` builds lighter; release/archive settings are
      # left alone.
      if ['Debug', 'Profile'].include?(config.name)
        config.build_settings['COMPILER_INDEX_STORE_ENABLE'] = 'NO'
      end

      if config.name == 'Debug'
        # Debug builds only need the active device/simulator architecture and
        # lightweight debug info, which keeps incremental Xcode builds faster.
        config.build_settings['ONLY_ACTIVE_ARCH'] = 'YES'
        config.build_settings['DEBUG_INFORMATION_FORMAT'] = 'dwarf'
      end
    end
  end
end
