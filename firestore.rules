rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ──────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ── users ─────────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isSignedIn();
      // only the account holder can write their own document
      allow create: if isOwner(uid);
      allow update: if isOwner(uid)
                    && !request.resource.data.diff(resource.data).affectedKeys()
                        .hasAny(['isPremium']); // isPremium is server-only
      allow delete: if false;
    }

    // ── places ────────────────────────────────────────────────────────────────
    match /places/{placeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.createdByUserId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.createdByUserId);
    }

    // ── notes ─────────────────────────────────────────────────────────────────
    match /notes/{noteId} {
      allow read: if isSignedIn();
      // notes are created by the server logic tied to a place
      allow create: if isSignedIn();
      // only messageCount increment is allowed from clients
      allow update: if isSignedIn()
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['messageCount']);
      allow delete: if false;
    }

    // ── messages ──────────────────────────────────────────────────────────────
    match /messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.content is string
                    && request.resource.data.content.size() <= 1000
                    // at least one of content or imageUrl must be present
                    && (request.resource.data.content.size() > 0
                        || request.resource.data.keys().hasAny(['imageUrl']));

      // Author can soft-delete their own message (isDeleted + deletedAt only).
      allow update: if isOwner(resource.data.userId)
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['isDeleted', 'deletedAt']);

      // Any signed-in user can increment reportCount (one field only).
      allow update: if isSignedIn()
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['reportCount']);

      // isVisible / moderatedAt / moderationReason are written only by Cloud
      // Functions via the Admin SDK, which bypasses security rules entirely.
      allow delete: if false;
    }

    // ── reports ───────────────────────────────────────────────────────────────
    match /reports/{reportId} {
      // Reports are write-only from clients; read/update/delete only via Admin SDK.
      allow create: if isSignedIn()
                    && request.resource.data.reporterId == request.auth.uid
                    && request.resource.data.messageId is string
                    && request.resource.data.reason is string;
      allow read, update, delete: if false;
    }
  }
}
