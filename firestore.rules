rules_version = '2';

// Assumed data ownership model:
// - users/{uid}: private account and entitlement data; owner-readable.
// - publicProfiles/{uid}: authenticated-readable display data and counters.
// - socialEdges/{edgeId}: authenticated-readable, server-managed follow edge.
// - users/{uid}/notificationSettings: owner-readable, server-managed settings.
// - users/{uid}/fcmTokens: sensitive server-managed delivery endpoints.
// - users/{uid}/noteStates/{placeId}: private server-managed map activity
//   state (non-negative lastSeenMessageCount and server timestamps).
// - users/{uid}/notices: server-created inbox; owner may only set readAt.
// - places/{placeId}: server-created note metadata and aggregates.
// - places/{placeId}/messages: server-created message content.
// - place access, visitor, like, counter and secret subcollections are scoped
//   by the parent note and otherwise server-managed as declared below.
// - moderation, invite, report and audit collections are server-only.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ──────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isCurrentUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isPlaceMaintainer(place) {
      return isSignedIn()
             && (place.createdByUserId == request.auth.uid
                 || (place.maintainerIds is list
                     && request.auth.uid in place.maintainerIds));
    }

    // Returns the data map of a place document.
    function getPlace(placeId) {
      return get(/databases/$(database)/documents/places/$(placeId)).data;
    }

    // True if the caller holds a still-valid access grant for a private note:
    // either invited, or unlocked at the note's current passwordVersion
    // (changing the password bumps the version, revoking old grants).
    function hasNoteMembership(placeId, place) {
      let path = /databases/$(database)/documents/places/$(placeId)/members/$(request.auth.uid);
      return exists(path)
             && (get(path).data.invited == true
                 || get(path).data.viaPasswordVersion == place.passwordVersion);
    }

    // True if the caller may access a note's messages: public notes are open
    // to all signed-in users; private notes require maintenance or membership.
    // get() results are cached per request, so this costs ~1-2 reads for a
    // whole messages query, not per message.
    function canAccessNote(placeId) {
      let place = getPlace(placeId);
      return isSignedIn()
             && (isPlaceMaintainer(place)
                 || (isPubliclyReadablePlace(place)
                     && (place.visibility == 'public'
                         || hasNoteMembership(placeId, place))));
    }

    function isPubliclyReadablePlace(place) {
      return place.isArchived == false
             && place.publishAt <= request.time
             && place.expiresAt > request.time;
    }

    function canListOwnedPlace(place) {
      // My Notes list queries are constrained with
      // `where('maintainerIds', arrayContains: request.auth.uid)`.
      // Keep the list rule in the same shape so Firestore can prove every
      // returned document is readable. The creator is also stored in
      // maintainerIds at write/migration time.
      return isSignedIn()
             && request.auth.uid in place.maintainerIds;
    }

    function canGetPlace(place) {
      return isPlaceMaintainer(place) || isPubliclyReadablePlace(place);
    }

    function isPubliclyVisibleMessage(message) {
      return message.isVisible == true
             && message.isPubliclyVisible == true;
    }

    function isValidNotice(notice) {
      return notice.keys().hasOnly([
               'category',
               'severity',
               'title',
               'body',
               'action',
               'sourceType',
               'sourceId',
               'createdAt',
               'readAt'
             ])
             && notice.category is string
             && notice.category.size() > 0
             && notice.category.size() <= 40
             && notice.severity in ['info', 'warning', 'critical']
             && notice.title is string
             && notice.title.size() > 0
             && notice.title.size() <= 120
             && notice.body is string
             && notice.body.size() > 0
             && notice.body.size() <= 2000
             && (notice.action == null || notice.action is map)
             && (notice.sourceType == null
                 || (notice.sourceType is string
                     && notice.sourceType.size() <= 80))
             && (notice.sourceId == null
                 || (notice.sourceId is string
                     && notice.sourceId.size() <= 200))
             && notice.createdAt is timestamp
             && (notice.readAt == null || notice.readAt is timestamp);
    }

    function isValidPublicProfile(profile) {
      return profile.keys().hasOnly([
               'displayName',
               'photoUrl',
               'followerCount',
               'followingCount',
               'createdAt',
               'updatedAt'
             ])
             && profile.displayName is string
             && profile.displayName.size() > 0
             && profile.displayName.size() <= 20
             && (profile.photoUrl == null
                 || (profile.photoUrl is string
                     && profile.photoUrl.size() <= 2000))
             && (!('followerCount' in profile)
                 || (profile.followerCount is int
                     && profile.followerCount >= 0))
             && (!('followingCount' in profile)
                 || (profile.followingCount is int
                     && profile.followingCount >= 0))
             && (!('createdAt' in profile)
                 || profile.createdAt is timestamp)
             && (!('updatedAt' in profile)
                 || profile.updatedAt is timestamp);
    }

    function createsOwnPublicProfile(uid) {
      return isCurrentUser(uid)
             && isValidPublicProfile(request.resource.data)
             && (!('followerCount' in request.resource.data)
                 || request.resource.data.followerCount == 0)
             && (!('followingCount' in request.resource.data)
                 || request.resource.data.followingCount == 0);
    }

    function updatesOwnPublicProfile(uid) {
      return isCurrentUser(uid)
             && isValidPublicProfile(resource.data)
             && isValidPublicProfile(request.resource.data)
             && request.resource.data.diff(resource.data)
                 .affectedKeys()
                 .hasOnly(['displayName', 'photoUrl', 'updatedAt'])
             && request.resource.data.followerCount ==
                 resource.data.followerCount
             && request.resource.data.followingCount ==
                 resource.data.followingCount;
    }

    function canReadMessage(placeId, message) {
      return canAccessNote(placeId)
             && (isPubliclyVisibleMessage(message)
                 || message.userId == request.auth.uid);
    }

    function isValidClientThreadStateTransition() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let closesThread = request.resource.data.isOpen == false
                         && request.resource.data.closedReason == 'owner'
                         && request.resource.data.closedAt == request.time;
      let reopensOwnerClosedThread = resource.data.isOpen == false
                                     && resource.data.closedReason == 'owner'
                                     && request.resource.data.isOpen == true
                                     && !('closedReason' in request.resource.data)
                                     && !('closedAt' in request.resource.data);
      return changed.hasOnly(['isOpen', 'closedReason', 'closedAt'])
             && request.resource.data.isOpen is bool
             && (closesThread || reopensOwnerClosedThread);
    }

    // ── users ─────────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isCurrentUser(uid);
      allow create: if isCurrentUser(uid)
                    && request.resource.data.keys()
                        .hasOnly(['displayName', 'email', 'photoUrl'])
                    && request.resource.data.displayName is string
                    && request.resource.data.displayName.size() > 0
                    && request.resource.data.displayName.size() <= 20
                    && (request.resource.data.email == null
                        || (request.resource.data.email is string
                            && request.resource.data.email.size() <= 320))
                    && (request.resource.data.photoUrl == null
                        || (request.resource.data.photoUrl is string
                            && request.resource.data.photoUrl.size() <= 2000));
      // Profile changes and all entitlement/counter fields are server-managed.
      allow update: if false;
      allow delete: if false;

      // Notification preferences are readable by the signed-in user, but only
      // callable Cloud Functions may change them. The server remains the single
      // source of truth for who can receive My Notes push notifications.
      match /notificationSettings/{settingsId} {
        allow read: if isCurrentUser(uid);
        allow write: if false;
      }

      // FCM registration tokens are sensitive delivery endpoints. Clients
      // register/delete them via Cloud Functions; no direct Firestore access.
      match /fcmTokens/{tokenId} {
        allow read, write: if false;
      }

      // Private map activity state. It is read and written only by callable
      // Cloud Functions so clients cannot forge seen counts or participation.
      match /noteStates/{placeId} {
        allow read, write: if false;
      }

      // User inbox. Notice content is server-managed, but the account holder
      // may mark a notice read by setting readAt to request.time.
      match /notices/{noticeId} {
        allow read: if isCurrentUser(uid);
        allow create: if false;
        allow update: if isCurrentUser(uid)
                      && isValidNotice(resource.data)
                      && isValidNotice(request.resource.data)
                      && request.resource.data.diff(resource.data)
                          .affectedKeys()
                          .hasOnly(['readAt'])
                      && request.resource.data.readAt == request.time;
        allow delete: if false;
      }
    }

    // ── public profiles ─────────────────────────────────────────────────────
    match /publicProfiles/{uid} {
      allow read: if isSignedIn();
      allow create: if createsOwnPublicProfile(uid);
      allow update: if updatesOwnPublicProfile(uid);
      allow delete: if false;
    }

    // Flat, graph-ready user-following edges. Clients may read relationship
    // pages, but all writes and public profile counters are maintained by the
    // setUserFollow Cloud Function.
    match /socialEdges/{edgeId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ── places ────────────────────────────────────────────────────────────────
    match /places/{placeId} {
      allow get: if isSignedIn() && canGetPlace(resource.data);
      allow list: if isSignedIn() && canListOwnedPlace(resource.data);

      // Direct client creation is DENIED. Notes are created exclusively by the
      // `createNote` Cloud Function (Admin SDK, which bypasses these rules),
      // which enforces the per-user note cap in a transaction and computes the
      // geohash server-side. This closes the bypass where a direct write could
      // exceed the configured free / premium cap.
      allow create: if false;

      // Maintainer writability changes (close / re-open).
      //   • Re-opening (isOpen → true) is allowed ONLY when the thread was
      //     closed manually by a maintainer; message-limit closes are
      //     permanent.
      allow update: if isPlaceMaintainer(resource.data)
                    && isValidClientThreadStateTransition();

      // messageCount / lastMessageAt are maintained ONLY by Cloud Functions
      // (Admin SDK, bypasses these rules). Clients used to write them directly,
      // which let anyone tamper with any note's counter (block posting, reset
      // the cap, reorder the list) — now denied.
      //
      // Lifecycle (isArchived/archivedAt), visibility, passwordVersion, and
      // lockType are likewise written ONLY by Cloud Functions. Clients can
      // never set them.

      allow delete: if false;

      // Password hash — written and read only by Cloud Functions (Admin SDK).
      // Clients must never see the hash, so all access is denied here.
      match /secret/{doc} {
        allow read, write: if false;
      }

      // Brute-force attempt counters — server-only.
      match /attempts/{uid} {
        allow read, write: if false;
      }

      // Access grants. A user may read their OWN membership; a note maintainer may
      // read the whole list (to manage access). Grants are written exclusively
      // by the unlockNote / claimInvite / revoke Cloud Functions.
      match /members/{memberUid} {
        allow read: if isSignedIn()
                    && (request.auth.uid == memberUid
                        || isPlaceMaintainer(getPlace(placeId)));
        allow write: if false;
      }

      // Server-only counters used by Cloud Functions. In particular,
      // counters/messageSlots includes unpublished scheduled messages and must
      // not be readable because that would leak future activity.
      match /counters/{counterId} {
        allow read, write: if false;
      }

      // Visitor footprints. Anyone who can access this note's content can see
      // the visitor list; writes are exclusively handled by Cloud Functions so
      // users cannot forge visit counts or profile fields.
      match /visitors/{visitorUid} {
        allow read: if canAccessNote(placeId);
        allow write: if false;
      }

      // Per-user like state. Clients may read only their own state; all
      // writes and the public places.likeCount aggregate are maintained by
      // Cloud Functions so the count cannot be forged or drift from the edge.
      match /likes/{likeUid} {
        allow read: if isCurrentUser(likeUid) && canAccessNote(placeId);
        allow write: if false;
      }

      // ── messages (subcollection) ──────────────────────────────────────
      // Nested under the place so reads can be gated on the parent note's
      // visibility + membership. For private notes, only maintainers and
      // unlocked/invited members can read or post.
      match /messages/{messageId} {
        allow read: if canReadMessage(placeId, resource.data);

        // Message creation and scheduled-message cancellation are handled by
        // callable Cloud Functions so the message document and cap counter
        // update happen in one transaction.
        allow create: if false;

        // Reports are submitted through the reportMessage callable so the
        // report event and moderation review queue stay in sync.
        allow update: if false;

        allow delete: if false;

        // Per-user message like state. Clients may read only their own edge;
        // writes and the public message.likeCount aggregate are maintained by
        // Cloud Functions so counts cannot be forged.
        match /messageLikes/{likeUid} {
          allow read: if isSignedIn()
                      && resource.data.userId == request.auth.uid
                      && canReadMessage(
                        placeId,
                        get(/databases/$(database)/documents/places/$(placeId)/messages/$(messageId)).data
                      );
          allow write: if false;
        }
      }
    }

    // Flat administrator review queue for non-allow moderation decisions.
    // Written only by Cloud Functions. Clients cannot read submitted content
    // or provider scores directly from Firestore.
    match /moderationReviews/{reviewId} {
      allow read, write: if false;
    }

    // Administrator moderation audit log. Written only by trusted Cloud
    // Functions with the Admin SDK.
    match /moderationAuditLogs/{logId} {
      allow read, write: if false;
    }

    // ── invites ─────────────────────────────────────────────────────────────
    // Invite tokens are secrets (the doc id is the token). Read/write only via
    // the createInviteLink / claimInvite / revokeInvite Cloud Functions
    // (Admin SDK); clients can never enumerate or read them.
    match /invites/{token} {
      allow read, write: if false;
    }

    // ── reports ───────────────────────────────────────────────────────────────
    match /reports/{reportId} {
      allow read, write: if false;
    }
  }
}
