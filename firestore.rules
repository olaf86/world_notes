rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ──────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Returns the data map of a place document.
    function getPlace(placeId) {
      return get(/databases/$(database)/documents/places/$(placeId)).data;
    }

    // True if the caller holds a still-valid access grant for a private note:
    // either invited, or unlocked at the note's current passwordVersion
    // (changing the password bumps the version, revoking old grants).
    function hasNoteMembership(placeId, place) {
      let path = /databases/$(database)/documents/places/$(placeId)/members/$(request.auth.uid);
      return exists(path)
             && (get(path).data.invited == true
                 || get(path).data.viaPasswordVersion == place.passwordVersion);
    }

    // True if the caller may access a note's messages: public notes are open
    // to all signed-in users; private notes require ownership or membership.
    // get() results are cached per request, so this costs ~1-2 reads for a
    // whole messages query, not per message.
    function canAccessNote(placeId) {
      let place = getPlace(placeId);
      return isSignedIn()
             && (place.visibility == 'public'
                 || request.auth.uid == place.createdByUserId
                 || hasNoteMembership(placeId, place));
    }

    // ── users ─────────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isSignedIn();
      // only the account holder can write their own document
      allow create: if isOwner(uid);
      // isPremium and activeNoteCount are server-managed (Cloud Functions /
      // RevenueCat sync). activeNoteCount is the source of truth for the note
      // creation cap, so the owner must NOT be able to reset it and bypass it.
      allow update: if isOwner(uid)
                    && !request.resource.data.diff(resource.data).affectedKeys()
                        .hasAny(['isPremium', 'activeNoteCount'])
                    // Defensive string-length caps (avoid storage abuse).
                    && (!request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['name'])
                        || request.resource.data.name.size() <= 100)
                    && (!request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['photoUrl'])
                        || request.resource.data.photoUrl.size() <= 2000);
      allow delete: if false;
    }

    // ── places ────────────────────────────────────────────────────────────────
    match /places/{placeId} {
      allow read: if isSignedIn();

      // Direct client creation is DENIED. Notes are created exclusively by the
      // `createNote` Cloud Function (Admin SDK, which bypasses these rules),
      // which enforces the per-user note cap in a transaction and computes the
      // geohash server-side. This closes the bypass where a direct write could
      // exceed the free (3) / premium (10) cap.
      allow create: if false;

      // Owner writability changes (close / re-open).
      //   • Re-opening (isOpen → true) is allowed ONLY when the thread was
      //     closed manually by the owner; message-limit closes are permanent.
      allow update: if isOwner(resource.data.createdByUserId)
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['isOpen', 'closedReason', 'closedAt'])
                    && (request.resource.data.isOpen == false
                        || resource.data.closedReason == 'owner');

      // messageCount / lastMessageAt are maintained ONLY by the onMessageCreated
      // Cloud Function trigger (Admin SDK, bypasses these rules). Clients used to
      // write them directly, which let anyone tamper with any note's counter
      // (block posting, reset the cap, reorder the list) — now denied.
      //
      // Lifecycle (isArchived/archivedAt), visibility, and passwordVersion are
      // likewise written ONLY by Cloud Functions. Clients can never set them.

      allow delete: if false;

      // Password hash — written and read only by Cloud Functions (Admin SDK).
      // Clients must never see the hash, so all access is denied here.
      match /secret/{doc} {
        allow read, write: if false;
      }

      // Brute-force attempt counters — server-only.
      match /attempts/{uid} {
        allow read, write: if false;
      }

      // Access grants. A user may read their OWN membership; the note owner may
      // read the whole list (to manage access). Grants are written exclusively
      // by the unlockNote / claimInvite / revoke Cloud Functions.
      match /members/{memberUid} {
        allow read: if isSignedIn()
                    && (request.auth.uid == memberUid
                        || getPlace(placeId).createdByUserId == request.auth.uid);
        allow write: if false;
      }

      // ── messages (subcollection) ──────────────────────────────────────
      // Nested under the place so reads can be gated on the parent note's
      // visibility + membership. For private notes, only the owner and
      // unlocked/invited members can read or post.
      match /messages/{messageId} {
        allow read: if canAccessNote(placeId);

        allow create: if canAccessNote(placeId)
                      && request.resource.data.userId == request.auth.uid
                      && request.resource.data.placeId == placeId
                      && request.resource.data.content is string
                      && request.resource.data.content.size() <= 2000
                      // imageUrl, when present, must be a bounded string
                      && (!request.resource.data.keys().hasAny(['imageUrl'])
                          || (request.resource.data.imageUrl is string
                              && request.resource.data.imageUrl.size() <= 2000))
                      // at least one of content or imageUrl must be present
                      && (request.resource.data.content.size() > 0
                          || request.resource.data.keys().hasAny(['imageUrl']))
                      // thread must be open, not archived, not expired, < cap
                      && getPlace(placeId).isOpen == true
                      && getPlace(placeId).isArchived == false
                      && getPlace(placeId).expiresAt > request.time
                      && getPlace(placeId).messageCount < 1000;

        // Author soft-deletes own message (isDeleted + deletedAt only).
        allow update: if isOwner(resource.data.userId)
                      && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['isDeleted', 'deletedAt']);

        // Any member can report — but only a monotonic +1 to reportCount, so a
        // user can't reset their own count to evade moderation or inflate one.
        allow update: if canAccessNote(placeId)
                      && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['reportCount'])
                      && request.resource.data.reportCount is int
                      && request.resource.data.reportCount
                          == resource.data.reportCount + 1;

        allow delete: if false;
      }
    }

    // The legacy top-level `notes` collection was merged into `places`; it has
    // no rule block, so it falls through to default-deny.

    // ── invites ─────────────────────────────────────────────────────────────
    // Invite tokens are secrets (the doc id is the token). Read/write only via
    // the createInviteLink / claimInvite / revokeInvite Cloud Functions
    // (Admin SDK); clients can never enumerate or read them.
    match /invites/{token} {
      allow read, write: if false;
    }

    // ── reports ───────────────────────────────────────────────────────────────
    match /reports/{reportId} {
      allow create: if isSignedIn()
                    && request.resource.data.reporterId == request.auth.uid
                    && request.resource.data.messageId is string
                    && request.resource.data.messageId.size() <= 200
                    && request.resource.data.reason is string
                    && request.resource.data.reason.size() <= 500;
      allow read, update, delete: if false;
    }
  }
}
