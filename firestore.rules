rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ──────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ── users ─────────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isSignedIn();
      // only the account holder can write their own document
      allow create: if isOwner(uid);
      allow update: if isOwner(uid)
                    && !request.resource.data.diff(resource.data).affectedKeys()
                        .hasAny(['isPremium']); // isPremium is server-only
      allow delete: if false;
    }

    // ── places ────────────────────────────────────────────────────────────────
    match /places/{placeId} {
      allow read: if isSignedIn();

      // Creation: authenticated user, owns the record, and has not yet reached
      // the absolute server-side cap (10 = premium max).
      // The free-tier cap (3) is enforced client-side before this write.
      allow create: if isSignedIn()
                    && request.resource.data.createdByUserId == request.auth.uid
                    && request.resource.data.status == 'active'
                    && !request.resource.data.isLocked;

      // Owner may update lifecycle fields (status, closedAt, archivedAt).
      allow update: if isOwner(resource.data.createdByUserId)
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['status', 'closedAt', 'archivedAt']);

      // Owner may update lock / password fields.
      allow update: if isOwner(resource.data.createdByUserId)
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['isLocked', 'passwordHash']);

      // Server (Admin SDK via Cloud Functions) may update messageCount and
      // lastMessageAt; clients must not touch these directly.
      // Currently the client increments messageCount from message_repository —
      // allow it until a Cloud Function is added.
      allow update: if isOwner(resource.data.createdByUserId)
                    || (isSignedIn()
                        && request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['messageCount', 'lastMessageAt']));

      allow delete: if false;
    }

    // ── notes ─────────────────────────────────────────────────────────────────
    match /notes/{noteId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn()
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['messageCount']);
      allow delete: if false;
    }

    // ── messages ──────────────────────────────────────────────────────────────
    match /messages/{messageId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.content is string
                    && request.resource.data.content.size() <= 2000
                    // at least one of content or imageUrl must be present
                    && (request.resource.data.content.size() > 0
                        || request.resource.data.keys().hasAny(['imageUrl']))
                    // thread must be active and below the message cap
                    && exists(/databases/$(database)/documents/places/$(request.resource.data.placeId))
                    && get(/databases/$(database)/documents/places/$(request.resource.data.placeId)).data.status == 'active'
                    && get(/databases/$(database)/documents/places/$(request.resource.data.placeId)).data.messageCount < 1000;

      // Author can soft-delete their own message (isDeleted + deletedAt only).
      allow update: if isOwner(resource.data.userId)
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['isDeleted', 'deletedAt']);

      // Any signed-in user can increment reportCount (one field only).
      allow update: if isSignedIn()
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['reportCount']);

      allow delete: if false;
    }

    // ── reports ───────────────────────────────────────────────────────────────
    match /reports/{reportId} {
      allow create: if isSignedIn()
                    && request.resource.data.reporterId == request.auth.uid
                    && request.resource.data.messageId is string
                    && request.resource.data.reason is string;
      allow read, update, delete: if false;
    }
  }
}
