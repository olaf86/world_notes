rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ──────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isCurrentUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isPlaceMaintainer(place) {
      return isSignedIn()
             && (place.createdByUserId == request.auth.uid
                 || (place.maintainerIds is list
                     && request.auth.uid in place.maintainerIds));
    }

    // Returns the data map of a place document.
    function getPlace(placeId) {
      return get(/databases/$(database)/documents/places/$(placeId)).data;
    }

    // True if the caller holds a still-valid access grant for a private note:
    // either invited, or unlocked at the note's current passwordVersion
    // (changing the password bumps the version, revoking old grants).
    function hasNoteMembership(placeId, place) {
      let path = /databases/$(database)/documents/places/$(placeId)/members/$(request.auth.uid);
      return exists(path)
             && (get(path).data.invited == true
                 || get(path).data.viaPasswordVersion == place.passwordVersion);
    }

    // True if the caller may access a note's messages: public notes are open
    // to all signed-in users; private notes require maintenance or membership.
    // get() results are cached per request, so this costs ~1-2 reads for a
    // whole messages query, not per message.
    function canAccessNote(placeId) {
      let place = getPlace(placeId);
      return isSignedIn()
             && (isPlaceMaintainer(place)
                 || (isPubliclyReadablePlace(place)
                     && (place.visibility == 'public'
                         || hasNoteMembership(placeId, place))));
    }

    function isPubliclyReadablePlace(place) {
      return place.isArchived == false
             && place.publishAt <= request.time
             && place.expiresAt > request.time;
    }

    function canListOwnedPlace(place) {
      return isPlaceMaintainer(place);
    }

    function canGetPlace(place) {
      return isPlaceMaintainer(place) || isPubliclyReadablePlace(place);
    }

    function isPubliclyVisibleMessage(message) {
      return message.isVisible == true
             && message.isPubliclyVisible == true;
    }

    function isValidNotice(notice) {
      return notice.keys().hasOnly([
               'category',
               'severity',
               'title',
               'body',
               'action',
               'sourceType',
               'sourceId',
               'createdAt',
               'readAt'
             ])
             && notice.category is string
             && notice.category.size() > 0
             && notice.category.size() <= 40
             && notice.severity in ['info', 'warning', 'critical']
             && notice.title is string
             && notice.title.size() > 0
             && notice.title.size() <= 120
             && notice.body is string
             && notice.body.size() > 0
             && notice.body.size() <= 2000
             && (notice.action == null || notice.action is map)
             && (notice.sourceType == null
                 || (notice.sourceType is string
                     && notice.sourceType.size() <= 80))
             && (notice.sourceId == null
                 || (notice.sourceId is string
                     && notice.sourceId.size() <= 200))
             && notice.createdAt is timestamp
             && (notice.readAt == null || notice.readAt is timestamp);
    }

    function canReadMessage(placeId, message) {
      return canAccessNote(placeId)
             && (isPubliclyVisibleMessage(message)
                 || message.userId == request.auth.uid);
    }

    // ── users ─────────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isCurrentUser(uid);
      allow create: if isCurrentUser(uid)
                    && request.resource.data.keys()
                        .hasOnly(['displayName', 'email', 'photoUrl'])
                    && request.resource.data.displayName is string
                    && request.resource.data.displayName.size() > 0
                    && request.resource.data.displayName.size() <= 20
                    && (request.resource.data.email == null
                        || (request.resource.data.email is string
                            && request.resource.data.email.size() <= 320))
                    && (request.resource.data.photoUrl == null
                        || (request.resource.data.photoUrl is string
                            && request.resource.data.photoUrl.size() <= 2000));
      // Profile changes and all entitlement/counter fields are server-managed.
      allow update: if false;
      allow delete: if false;

      // Notification preferences are readable by the signed-in user, but only
      // callable Cloud Functions may change them. The server remains the single
      // source of truth for who can receive My Notes push notifications.
      match /notificationSettings/{settingsId} {
        allow read: if isCurrentUser(uid);
        allow write: if false;
      }

      // FCM registration tokens are sensitive delivery endpoints. Clients
      // register/delete them via Cloud Functions; no direct Firestore access.
      match /fcmTokens/{tokenId} {
        allow read, write: if false;
      }

      // User-facing mirror of nearby note alerts. Read-only for the account
      // holder; all changes go through callable Cloud Functions so access,
      // maintainer exclusion, and the 5-note cap stay server-enforced.
      match /nearbyNotificationPlaces/{placeId} {
        allow read: if isCurrentUser(uid);
        allow write: if false;
      }

      // User inbox. Notice content is server-managed, but the account holder
      // may mark a notice read by setting readAt to request.time.
      match /notices/{noticeId} {
        allow read: if isCurrentUser(uid);
        allow create: if false;
        allow update: if isCurrentUser(uid)
                      && isValidNotice(resource.data)
                      && isValidNotice(request.resource.data)
                      && request.resource.data.diff(resource.data)
                          .affectedKeys()
                          .hasOnly(['readAt'])
                      && request.resource.data.readAt == request.time;
        allow delete: if false;
      }
    }

    // ── places ────────────────────────────────────────────────────────────────
    match /places/{placeId} {
      allow get: if isSignedIn() && canGetPlace(resource.data);
      allow list: if isSignedIn() && canListOwnedPlace(resource.data);

      // Direct client creation is DENIED. Notes are created exclusively by the
      // `createNote` Cloud Function (Admin SDK, which bypasses these rules),
      // which enforces the per-user note cap in a transaction and computes the
      // geohash server-side. This closes the bypass where a direct write could
      // exceed the configured free / premium cap.
      allow create: if false;

      // Maintainer writability changes (close / re-open).
      //   • Re-opening (isOpen → true) is allowed ONLY when the thread was
      //     closed manually by a maintainer; message-limit closes are
      //     permanent.
      allow update: if isPlaceMaintainer(resource.data)
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['isOpen', 'closedReason', 'closedAt'])
                    && (request.resource.data.isOpen == false
                        || resource.data.closedReason == 'owner');

      // messageCount / lastMessageAt are maintained ONLY by Cloud Functions
      // (Admin SDK, bypasses these rules). Clients used to write them directly,
      // which let anyone tamper with any note's counter (block posting, reset
      // the cap, reorder the list) — now denied.
      //
      // Lifecycle (isArchived/archivedAt), visibility, passwordVersion, and
      // lockType are likewise written ONLY by Cloud Functions. Clients can
      // never set them.

      allow delete: if false;

      // Password hash — written and read only by Cloud Functions (Admin SDK).
      // Clients must never see the hash, so all access is denied here.
      match /secret/{doc} {
        allow read, write: if false;
      }

      // Brute-force attempt counters — server-only.
      match /attempts/{uid} {
        allow read, write: if false;
      }

      // Access grants. A user may read their OWN membership; a note maintainer may
      // read the whole list (to manage access). Grants are written exclusively
      // by the unlockNote / claimInvite / revoke Cloud Functions.
      match /members/{memberUid} {
        allow read: if isSignedIn()
                    && (request.auth.uid == memberUid
                        || isPlaceMaintainer(getPlace(placeId)));
        allow write: if false;
      }

      // Server-only counters used by Cloud Functions. In particular,
      // counters/messageSlots includes unpublished scheduled messages and must
      // not be readable because that would leak future activity.
      match /counters/{counterId} {
        allow read, write: if false;
      }

      // Server-managed nearby-alert subscription state. Clients read their
      // user mirror instead; Functions use this collection for message sends.
      match /nearbyNotificationFollowers/{memberUid} {
        allow read, write: if false;
      }

      // ── messages (subcollection) ──────────────────────────────────────
      // Nested under the place so reads can be gated on the parent note's
      // visibility + membership. For private notes, only maintainers and
      // unlocked/invited members can read or post.
      match /messages/{messageId} {
        allow read: if canReadMessage(placeId, resource.data);

        // Message creation and scheduled-message cancellation are handled by
        // callable Cloud Functions so the message document and cap counter
        // update happen in one transaction.
        allow create: if false;

        // Any member can report — but only a monotonic +1 to reportCount, so a
        // user can't reset their own count to evade moderation or inflate one.
        allow update: if canReadMessage(placeId, resource.data)
                      && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['reportCount'])
                      && request.resource.data.reportCount is int
                      && request.resource.data.reportCount
                          == resource.data.reportCount + 1;

        allow delete: if false;
      }
    }

    // Flat administrator review queue for non-allow moderation decisions.
    // Written only by Cloud Functions. Clients cannot read submitted content
    // or provider scores directly from Firestore.
    match /moderationReviews/{reviewId} {
      allow read, write: if false;
    }

    // ── invites ─────────────────────────────────────────────────────────────
    // Invite tokens are secrets (the doc id is the token). Read/write only via
    // the createInviteLink / claimInvite / revokeInvite Cloud Functions
    // (Admin SDK); clients can never enumerate or read them.
    match /invites/{token} {
      allow read, write: if false;
    }

    // ── reports ───────────────────────────────────────────────────────────────
    match /reports/{reportId} {
      allow create: if isSignedIn()
                    && request.resource.data.reporterId == request.auth.uid
                    && request.resource.data.messageId is string
                    && request.resource.data.messageId.size() <= 200
                    && request.resource.data.reason is string
                    && request.resource.data.reason.size() <= 500;
      allow read, update, delete: if false;
    }
  }
}
