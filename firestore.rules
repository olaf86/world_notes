rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ──────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Returns the data map of a place document.
    function getPlace(placeId) {
      return get(/databases/$(database)/documents/places/$(placeId)).data;
    }

    // True if the caller holds a still-valid access grant for a private note:
    // either invited, or unlocked at the note's current passwordVersion
    // (changing the password bumps the version, revoking old grants).
    function hasNoteMembership(placeId, place) {
      let path = /databases/$(database)/documents/places/$(placeId)/members/$(request.auth.uid);
      return exists(path)
             && (get(path).data.invited == true
                 || get(path).data.viaPasswordVersion == place.passwordVersion);
    }

    // True if the caller may access a note's messages: public notes are open
    // to all signed-in users; private notes require ownership or membership.
    // get() results are cached per request, so this costs ~1-2 reads for a
    // whole messages query, not per message.
    function canAccessNote(placeId) {
      let place = getPlace(placeId);
      return isSignedIn()
             && (place.visibility == 'public'
                 || request.auth.uid == place.createdByUserId
                 || hasNoteMembership(placeId, place));
    }

    // ── users ─────────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isSignedIn();
      // only the account holder can write their own document
      allow create: if isOwner(uid);
      allow update: if isOwner(uid)
                    && !request.resource.data.diff(resource.data).affectedKeys()
                        .hasAny(['isPremium']); // isPremium is server-only
      allow delete: if false;
    }

    // ── places ────────────────────────────────────────────────────────────────
    match /places/{placeId} {
      allow read: if isSignedIn();

      // Direct client creation is DENIED. Notes are created exclusively by the
      // `createNote` Cloud Function (Admin SDK, which bypasses these rules),
      // which enforces the per-user note cap in a transaction and computes the
      // geohash server-side. This closes the bypass where a direct write could
      // exceed the free (3) / premium (10) cap.
      allow create: if false;

      // Owner writability changes (close / re-open).
      //   • Re-opening (isOpen → true) is allowed ONLY when the thread was
      //     closed manually by the owner; message-limit closes are permanent.
      allow update: if isOwner(resource.data.createdByUserId)
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['isOpen', 'closedReason', 'closedAt'])
                    && (request.resource.data.isOpen == false
                        || resource.data.closedReason == 'owner');

      // Message counter — any signed-in user posting a message increments it.
      // (Will move to a Cloud Function later for tamper-proofing.)
      allow update: if isSignedIn()
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['messageCount', 'lastMessageAt']);

      // Lifecycle (isArchived/archivedAt), visibility, and passwordVersion are
      // written ONLY by Cloud Functions via the Admin SDK, which bypasses
      // these rules. Clients can never set them after creation.

      allow delete: if false;

      // Password hash — written and read only by Cloud Functions (Admin SDK).
      // Clients must never see the hash, so all access is denied here.
      match /secret/{doc} {
        allow read, write: if false;
      }

      // Brute-force attempt counters — server-only.
      match /attempts/{uid} {
        allow read, write: if false;
      }

      // Access grants. A user may read their OWN membership (to know whether
      // they still have access after a password change), but grants are
      // written exclusively by the unlockNote / invite Cloud Functions.
      match /members/{uid} {
        allow read: if isSignedIn() && request.auth.uid == uid;
        allow write: if false;
      }

      // ── messages (subcollection) ──────────────────────────────────────
      // Nested under the place so reads can be gated on the parent note's
      // visibility + membership. For private notes, only the owner and
      // unlocked/invited members can read or post.
      match /messages/{messageId} {
        allow read: if canAccessNote(placeId);

        allow create: if canAccessNote(placeId)
                      && request.resource.data.userId == request.auth.uid
                      && request.resource.data.placeId == placeId
                      && request.resource.data.content is string
                      && request.resource.data.content.size() <= 2000
                      // at least one of content or imageUrl must be present
                      && (request.resource.data.content.size() > 0
                          || request.resource.data.keys().hasAny(['imageUrl']))
                      // thread must be open, not archived, not expired, < cap
                      && getPlace(placeId).isOpen == true
                      && getPlace(placeId).isArchived == false
                      && getPlace(placeId).expiresAt > request.time
                      && getPlace(placeId).messageCount < 1000;

        // Author soft-deletes own message (isDeleted + deletedAt only).
        allow update: if isOwner(resource.data.userId)
                      && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['isDeleted', 'deletedAt']);

        // Any member can increment reportCount (one field only).
        allow update: if canAccessNote(placeId)
                      && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['reportCount']);

        allow delete: if false;
      }
    }

    // ── notes ─────────────────────────────────────────────────────────────────
    match /notes/{noteId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn()
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['messageCount']);
      allow delete: if false;
    }

    // ── reports ───────────────────────────────────────────────────────────────
    match /reports/{reportId} {
      allow create: if isSignedIn()
                    && request.resource.data.reporterId == request.auth.uid
                    && request.resource.data.messageId is string
                    && request.resource.data.reason is string;
      allow read, update, delete: if false;
    }
  }
}
