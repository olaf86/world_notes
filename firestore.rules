rules_version = '2';

// Assumed data ownership model:
// - userHomes/{uid}: immutable server-written routing marker. Required fields:
//   world (non-empty string), epoch (positive integer), createdAt (timestamp).
//   Only that uid may read the exact document; collection listing is denied.
// - users/{uid}: private owner-readable account data. The trusted bootstrap
//   writes Auth-derived identity, language preference, and timestamps.
// - userEntitlements/{uid}: server-only world-local entitlement mirror with
//   isPremium (bool) and updatedAt (timestamp).
// - userUsage/{uid}: server-only independent world usage with
//   activeNoteCount (non-negative integer) and updatedAt (timestamp).
// - accountSafety/{uid}: server-only authority or regional enforcement mirror
//   containing a revisioned 0-100 score, independent automated/admin expiry
//   sources, effective restriction/BAN fields, authority world and timestamps.
//   appliedEvents receipts and adminAudits below it are also server-only.
// - globalOperations/{operationId}: server-written durable global-command
//   status. Contains bounded routing/status metadata, revision, SHA-256
//   payloadHash, required-world snapshot, acknowledgements and timestamps.
//   The bound owner may get only an exact known operation ID; listing and all
//   client writes are denied.
// - publicProfiles/{uid}: authenticated-readable display data; displayName,
//   nullable photoUrl, photoVersion, counters, createdAt and updatedAt are
//   required. All writes are trusted-server only.
// - socialEdges/{edgeId}: server-managed directed follow state. Required
//   fields: followerUid/followeeUid (bounded UID strings), following (bool),
//   revision (positive integer), nullable createdAt and updatedAt (timestamp).
//   Only active (`following == true`) edges are authenticated-readable;
//   inactive revision tombstones remain server-only.
// - users/{uid}/blockedUsers/{blockedUid}: server-managed directional block
//   projection. Only active relationships are owner-readable; inactive
//   revision tombstones remain server-only until TTL expiry.
// - users/{uid}/notificationSettings: owner-readable, server-managed settings.
// - users/{uid}/fcmTokens: sensitive server-managed delivery endpoints.
// - users/{uid}/noteStates/{placeId}: private server-managed map activity
//   state (non-negative lastSeenMessageCount and server timestamps).
// - users/{uid}/notices: server-created inbox; owner may only set readAt.
// - places/{placeId}: server-created note metadata and aggregates.
// - places/{placeId}/messages: server-created message content.
// - place access, visitor, like, counter and secret subcollections are scoped
//   by the parent note and otherwise server-managed as declared below.
// - moderation, invite, report and audit collections are server-only.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ──────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isCurrentUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function hasReadyAccount() {
      let path = /databases/$(database)/documents/userHomes/$(request.auth.uid);
      return isSignedIn()
             && exists(path)
             && get(path).data.world is string
             && get(path).data.world.size() > 0
             && get(path).data.world.size() <= 32
             && get(path).data.epoch is int
             && get(path).data.epoch > 0;
    }

    function isEffectiveSafetyExpiry(effective, automated, administrator) {
      return (effective == null
              && automated == null
              && administrator == null)
             || (effective is timestamp
                 && (automated == null || automated <= effective)
                 && (administrator == null || administrator <= effective)
                 && (effective == automated || effective == administrator));
    }

    function isValidAccountSafetyProjection(safety) {
      return safety.keys().hasOnly([
               'revision',
               'violationPoints',
               'lastViolationAt',
               'nextPointDecayAt',
               'automatedRestrictedUntil',
               'automatedBannedUntil',
               'adminRestrictedUntil',
               'adminBannedUntil',
               'restrictedUntil',
               'bannedUntil',
               'isPermanentlyBanned',
               'authorityWorld',
               'updatedAt'
             ])
             && safety.revision is int
             && safety.revision > 0
             && safety.violationPoints is int
             && safety.violationPoints >= 0
             && safety.violationPoints <= 100
             && (safety.lastViolationAt == null
                 || safety.lastViolationAt is timestamp)
             && (safety.nextPointDecayAt == null
                 || safety.nextPointDecayAt is timestamp)
             && (safety.automatedRestrictedUntil == null
                 || safety.automatedRestrictedUntil is timestamp)
             && (safety.automatedBannedUntil == null
                 || safety.automatedBannedUntil is timestamp)
             && (safety.adminRestrictedUntil == null
                 || safety.adminRestrictedUntil is timestamp)
             && (safety.adminBannedUntil == null
                 || safety.adminBannedUntil is timestamp)
             && (safety.restrictedUntil == null
                 || safety.restrictedUntil is timestamp)
             && (safety.bannedUntil == null
                 || safety.bannedUntil is timestamp)
             && safety.isPermanentlyBanned is bool
             && safety.authorityWorld is string
             && safety.authorityWorld.size() > 0
             && safety.authorityWorld.size() <= 32
             && safety.updatedAt is timestamp
             && isEffectiveSafetyExpiry(
                  safety.restrictedUntil,
                  safety.automatedRestrictedUntil,
                  safety.adminRestrictedUntil
                )
             && isEffectiveSafetyExpiry(
                  safety.bannedUntil,
                  safety.automatedBannedUntil,
                  safety.adminBannedUntil
                );
    }

    function accountSafetyAllowsContentWrite(safety) {
      return isValidAccountSafetyProjection(safety)
             && safety.isPermanentlyBanned == false
             && (safety.bannedUntil == null
                 || safety.bannedUntil <= request.time)
             && (safety.restrictedUntil == null
                 || safety.restrictedUntil <= request.time);
    }

    function canPerformContentWrite() {
      let path = /databases/$(database)/documents/accountSafety/$(request.auth.uid);
      return hasReadyAccount()
             && exists(path)
             && accountSafetyAllowsContentWrite(get(path).data);
    }

    function hasActiveUserBlock(blockerUid, blockedUid) {
      let path = /databases/$(database)/documents/users/$(blockerUid)/blockedUsers/$(blockedUid);
      return exists(path) && get(path).data.isBlocked == true;
    }

    function hasUserBlockBetween(firstUid, secondUid) {
      return firstUid != secondUid
             && (hasActiveUserBlock(firstUid, secondUid)
                 || hasActiveUserBlock(secondUid, firstUid));
    }

    function canInteractWithPlaceCreator(place) {
      return isSignedIn()
             && !hasUserBlockBetween(
                  request.auth.uid,
                  place.createdByUserId
                );
    }

    function isPlaceMaintainer(place) {
      return isSignedIn()
             && canInteractWithPlaceCreator(place)
             && (place.createdByUserId == request.auth.uid
                 || (place.maintainerIds is list
                     && request.auth.uid in place.maintainerIds));
    }

    // Returns the data map of a place document.
    function getPlace(placeId) {
      return get(/databases/$(database)/documents/places/$(placeId)).data;
    }

    // True if the caller holds a still-valid access grant for a private note:
    // either invited, or unlocked at the note's current passwordVersion
    // (changing the password bumps the version, revoking old grants).
    function hasNoteMembership(placeId, place) {
      let path = /databases/$(database)/documents/places/$(placeId)/members/$(request.auth.uid);
      return exists(path)
             && (get(path).data.invited == true
                 || get(path).data.viaPasswordVersion == place.passwordVersion);
    }

    // True if the caller may access a note's messages: public notes are open
    // to all signed-in users; private notes require maintenance or membership.
    // get() results are cached per request, so this costs ~1-2 reads for a
    // whole messages query, not per message.
    function canAccessNote(placeId) {
      let place = getPlace(placeId);
      return isSignedIn()
             && canInteractWithPlaceCreator(place)
             && (isPlaceMaintainer(place)
                 || (place.visibility == 'public'
                     && isPubliclyReadablePlace(place))
                 || (place.visibility == 'private'
                     && hasNoteMembership(placeId, place)));
    }

    function isPubliclyReadablePlace(place) {
      return place.isArchived == false
             && place.isModerationHidden == false
             && place.publishAt <= request.time
             && place.expiresAt > request.time;
    }

    function canListOwnedPlace(place) {
      // My Notes list queries are constrained with
      // `where('maintainerIds', arrayContains: request.auth.uid)`.
      // Keep the list rule in the same shape so Firestore can prove every
      // returned document is readable. The creator is also stored in
      // maintainerIds at write/migration time.
      return isSignedIn()
             && canInteractWithPlaceCreator(place)
             && request.auth.uid in place.maintainerIds;
    }

    // A signed-in visitor must read an active private note's display metadata
    // (title, lock type, and hint) before they can unlock it. Message content
    // remains protected separately by canAccessNote/canReadMessage.
    function canGetPlace(place) {
      return canInteractWithPlaceCreator(place)
             && (isPlaceMaintainer(place) || isPubliclyReadablePlace(place));
    }

    function isPubliclyVisibleMessage(message) {
      return message.isVisible == true
             && message.isPubliclyVisible == true;
    }

    function isValidNotice(notice) {
      return notice.keys().hasOnly([
               'category',
               'severity',
               'title',
               'body',
               'action',
               'sourceType',
               'sourceId',
               'createdAt',
               'readAt'
             ])
             && notice.category is string
             && notice.category.size() > 0
             && notice.category.size() <= 40
             && notice.severity in ['info', 'warning', 'critical']
             && notice.title is string
             && notice.title.size() > 0
             && notice.title.size() <= 120
             && notice.body is string
             && notice.body.size() > 0
             && notice.body.size() <= 2000
             && (notice.action == null || notice.action is map)
             && (notice.sourceType == null
                 || (notice.sourceType is string
                     && notice.sourceType.size() <= 80))
             && (notice.sourceId == null
                 || (notice.sourceId is string
                     && notice.sourceId.size() <= 200))
             && notice.createdAt is timestamp
             && (notice.readAt == null || notice.readAt is timestamp);
    }

    function canReadMessage(placeId, message) {
      return canAccessNote(placeId)
             && (isPubliclyVisibleMessage(message)
                 || message.userId == request.auth.uid);
    }

    function isValidClientThreadStateTransition() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let closesThread = request.resource.data.isOpen == false
                         && request.resource.data.closedReason == 'owner'
                         && request.resource.data.closedAt == request.time;
      let reopensOwnerClosedThread = resource.data.isOpen == false
                                     && resource.data.closedReason == 'owner'
                                     && request.resource.data.isOpen == true
                                     && !('closedReason' in request.resource.data)
                                     && !('closedAt' in request.resource.data);
      return changed.hasOnly(['isOpen', 'closedReason', 'closedAt'])
             && request.resource.data.isOpen is bool
             && (closesThread || reopensOwnerClosedThread);
    }

    // ── account bootstrap and private data ─────────────────────────────────
    match /userHomes/{uid} {
      allow get: if isCurrentUser(uid);
      allow list, create, update, delete: if false;
    }

    match /users/{uid} {
      allow read: if isCurrentUser(uid);
      allow create, update, delete: if false;

      // Notification preferences are readable by the signed-in user, but only
      // callable Cloud Functions may change them. The server remains the single
      // source of truth for who can receive My Notes push notifications.
      match /notificationSettings/{settingsId} {
        allow read: if isCurrentUser(uid);
        allow write: if false;
      }

      // FCM registration tokens are sensitive delivery endpoints. Clients
      // register/delete them via Cloud Functions; no direct Firestore access.
      match /fcmTokens/{tokenId} {
        allow read, write: if false;
      }

      // Private map activity state. It is read and written only by callable
      // Cloud Functions so clients cannot forge seen counts or participation.
      match /noteStates/{placeId} {
        allow read, write: if false;
      }

      // Private user-block list. Clients may observe only active entries in
      // their own list. Inactive revision tombstones are intentionally hidden.
      match /blockedUsers/{blockedUid} {
        allow read: if isCurrentUser(uid)
                    && resource.data.isBlocked == true;
        allow write: if false;
      }

      // User inbox. Notice content is server-managed, but the account holder
      // may mark a notice read by setting readAt to request.time.
      match /notices/{noticeId} {
        allow read: if isCurrentUser(uid);
        allow create: if false;
        allow update: if isCurrentUser(uid)
                      && hasReadyAccount()
                      && isValidNotice(resource.data)
                      && isValidNotice(request.resource.data)
                      && request.resource.data.diff(resource.data)
                          .affectedKeys()
                          .hasOnly(['readAt'])
                      && request.resource.data.readAt == request.time;
        allow delete: if false;
      }
    }

    match /userEntitlements/{uid} {
      allow read, write: if false;
    }

    match /userUsage/{uid} {
      allow read, write: if false;
    }

    match /accountSafety/{uid} {
      allow read, write: if false;

      match /appliedEvents/{eventId} {
        allow read, write: if false;
      }

      match /adminAudits/{auditId} {
        allow read, write: if false;
      }
    }

    match /globalOperations/{operationId} {
      allow get: if isSignedIn()
                 && resource.data.ownerUid == request.auth.uid
                 && resource.data.operationId == operationId;
      allow list, create, update, delete: if false;
    }

    // ── public profiles ─────────────────────────────────────────────────────
    match /publicProfiles/{uid} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Flat, graph-ready user-following edges. Every client query must include
    // `following == true`; this prevents inactive revision tombstones from
    // exposing former relationships. All writes and profile-counter changes
    // remain trusted-server only.
    match /socialEdges/{edgeId} {
      allow read: if isSignedIn() && resource.data.following == true;
      allow write: if false;
    }

    // ── places ────────────────────────────────────────────────────────────────
    match /places/{placeId} {
      allow get: if isSignedIn() && canGetPlace(resource.data);
      allow list: if isSignedIn() && canListOwnedPlace(resource.data);

      // Direct client creation is DENIED. Notes are created exclusively by the
      // `createNote` Cloud Function (Admin SDK, which bypasses these rules),
      // which enforces the per-user note cap in a transaction and computes the
      // geohash server-side. This closes the bypass where a direct write could
      // exceed the configured free / premium cap.
      allow create: if false;

      // Maintainer writability changes (close / re-open).
      //   • Re-opening (isOpen → true) is allowed ONLY when the thread was
      //     closed manually by a maintainer; message-limit closes are
      //     permanent.
      allow update: if isPlaceMaintainer(resource.data)
                    && hasReadyAccount()
                    && canPerformContentWrite()
                    && isValidClientThreadStateTransition();

      // messageCount / lastMessageAt are maintained ONLY by Cloud Functions
      // (Admin SDK, bypasses these rules). Clients used to write them directly,
      // which let anyone tamper with any note's counter (block posting, reset
      // the cap, reorder the list) — now denied.
      //
      // Lifecycle (isArchived/archivedAt), visibility, passwordVersion, and
      // lockType are likewise written ONLY by Cloud Functions. Clients can
      // never set them.

      allow delete: if false;

      // Password hash — written and read only by Cloud Functions (Admin SDK).
      // Clients must never see the hash, so all access is denied here.
      match /secret/{doc} {
        allow read, write: if false;
      }

      // Brute-force attempt counters — server-only.
      match /attempts/{uid} {
        allow read, write: if false;
      }

      // Access grants. A user may read their OWN membership; a note maintainer may
      // read the whole list (to manage access). Grants are written exclusively
      // by the unlockNote / claimInvite / revoke Cloud Functions.
      match /members/{memberUid} {
        allow read: if isSignedIn()
                    && (request.auth.uid == memberUid
                        || isPlaceMaintainer(getPlace(placeId)));
        allow write: if false;
      }

      // Server-only counters used by Cloud Functions. In particular,
      // counters/messageSlots includes unpublished scheduled messages and must
      // not be readable because that would leak future activity.
      match /counters/{counterId} {
        allow read, write: if false;
      }

      // Visitor footprints. Anyone who can access this note's content can see
      // the visitor list; writes are exclusively handled by Cloud Functions so
      // users cannot forge visit counts or profile fields.
      match /visitors/{visitorUid} {
        allow read: if canAccessNote(placeId);
        allow write: if false;
      }

      // Per-user like state. Clients may read only their own state; all
      // writes and the public places.likeCount aggregate are maintained by
      // Cloud Functions so the count cannot be forged or drift from the edge.
      match /likes/{likeUid} {
        allow read: if isCurrentUser(likeUid) && canAccessNote(placeId);
        allow write: if false;
      }

      // ── messages (subcollection) ──────────────────────────────────────
      // Nested under the place so reads can be gated on the parent note's
      // visibility + membership. For private notes, only maintainers and
      // unlocked/invited members can read or post.
      match /messages/{messageId} {
        allow read: if canReadMessage(placeId, resource.data);

        // Message creation and scheduled-message cancellation are handled by
        // callable Cloud Functions so the message document and cap counter
        // update happen in one transaction.
        allow create: if false;

        // Reports are submitted through the reportMessage callable so the
        // report event and moderation review queue stay in sync.
        allow update: if false;

        allow delete: if false;

      }

    }

    // Collection-group query support for the thread's own-like state. A
    // collection-group query requires this root-level recursive match. A
    // caller can list only edges whose stored owner is that caller; Cloud
    // Functions are the only writer, so clients cannot forge `userId`.
    // Keep `messageLikes` exclusive to this edge schema; a future unrelated
    // collection must use a different name to avoid matching this rule.
    // Individual document gets and all client writes remain denied by default.
    match /{path=**}/messageLikes/{likeId} {
      allow list: if isSignedIn()
                  && resource.data.userId == request.auth.uid;
    }

    // Flat administrator review queue for non-allow moderation decisions.
    // Written only by Cloud Functions. Clients cannot read submitted content
    // or provider scores directly from Firestore.
    match /moderationReviews/{reviewId} {
      allow read, write: if false;
    }

    // Automated and administrator moderation audit log. Written only by
    // trusted Cloud Functions with the Admin SDK.
    match /moderationAuditLogs/{logId} {
      allow read, write: if false;
    }

    // Server-only manifests used to track disposable moderation test data.
    match /moderationTestRuns/{runId} {
      allow read, write: if false;
    }

    // Exact Storage object paths used by cleanup workers are server-only.
    match /storageCleanupObjects/{jobId} {
      allow read, write: if false;
    }

    // ── invites ─────────────────────────────────────────────────────────────
    // Invite tokens are secrets (the doc id is the token). Read/write only via
    // the createInviteLink / claimInvite / revokeInvite Cloud Functions
    // (Admin SDK); clients can never enumerate or read them.
    match /invites/{token} {
      allow read, write: if false;
    }

    // ── reports ───────────────────────────────────────────────────────────────
    match /reports/{reportId} {
      allow read, write: if false;
    }
  }
}
