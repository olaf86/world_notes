rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ──────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Returns the data map of a place document.
    function getPlace(placeId) {
      return get(/databases/$(database)/documents/places/$(placeId)).data;
    }

    // ── users ─────────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isSignedIn();
      // only the account holder can write their own document
      allow create: if isOwner(uid);
      allow update: if isOwner(uid)
                    && !request.resource.data.diff(resource.data).affectedKeys()
                        .hasAny(['isPremium']); // isPremium is server-only
      allow delete: if false;
    }

    // ── places ────────────────────────────────────────────────────────────────
    match /places/{placeId} {
      allow read: if isSignedIn();

      // Creation rules:
      //   • caller owns the record
      //   • starts open, active (not archived)
      //   • expiresAt is in the future and at most 1 year out (max lifetime)
      // The free-tier note cap (3) and premium cap (10) are enforced
      // client-side via countUserActivePlaces() before this write.
      // Visibility may be set, but switching to 'private' with a real password
      // is finalised by a Cloud Function (Phase 3) — passwordVersion stays 0
      // here and the password hash is never written by the client.
      allow create: if isSignedIn()
                    && request.resource.data.createdByUserId == request.auth.uid
                    && request.resource.data.isOpen == true
                    && request.resource.data.isArchived == false
                    && request.resource.data.visibility in ['public', 'private']
                    && request.resource.data.passwordVersion == 0
                    && request.resource.data.expiresAt > request.time
                    && request.resource.data.expiresAt
                        < request.time + duration.value(366, 'd');

      // Owner writability changes (close / re-open).
      //   • Re-opening (isOpen → true) is allowed ONLY when the thread was
      //     closed manually by the owner; message-limit closes are permanent.
      allow update: if isOwner(resource.data.createdByUserId)
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['isOpen', 'closedReason', 'closedAt'])
                    && (request.resource.data.isOpen == false
                        || resource.data.closedReason == 'owner');

      // Message counter — any signed-in user posting a message increments it.
      // (Will move to a Cloud Function later for tamper-proofing.)
      allow update: if isSignedIn()
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['messageCount', 'lastMessageAt']);

      // Lifecycle (isArchived/archivedAt), visibility, and passwordVersion are
      // written ONLY by Cloud Functions via the Admin SDK, which bypasses
      // these rules. Clients can never set them after creation.

      allow delete: if false;
    }

    // ── notes ─────────────────────────────────────────────────────────────────
    match /notes/{noteId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn()
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['messageCount']);
      allow delete: if false;
    }

    // ── messages ──────────────────────────────────────────────────────────────
    match /messages/{messageId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.content is string
                    && request.resource.data.content.size() <= 2000
                    // at least one of content or imageUrl must be present
                    && (request.resource.data.content.size() > 0
                        || request.resource.data.keys().hasAny(['imageUrl']))
                    // thread must be open, not archived, not expired, below cap
                    && exists(/databases/$(database)/documents/places/$(request.resource.data.placeId))
                    && getPlace(request.resource.data.placeId).isOpen == true
                    && getPlace(request.resource.data.placeId).isArchived == false
                    && getPlace(request.resource.data.placeId).expiresAt > request.time
                    && getPlace(request.resource.data.placeId).messageCount < 1000;

      // Author can soft-delete their own message (isDeleted + deletedAt only).
      allow update: if isOwner(resource.data.userId)
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['isDeleted', 'deletedAt']);

      // Any signed-in user can increment reportCount (one field only).
      allow update: if isSignedIn()
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['reportCount']);

      allow delete: if false;
    }

    // ── reports ───────────────────────────────────────────────────────────────
    match /reports/{reportId} {
      allow create: if isSignedIn()
                    && request.resource.data.reporterId == request.auth.uid
                    && request.resource.data.messageId is string
                    && request.resource.data.reason is string;
      allow read, update, delete: if false;
    }
  }
}
