rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ── message images ──────────────────────────────────────────────────────
    // Path: images/messages/{placeId}/{userId}/{uuidV7}/{0-3}.webp
    match /images/messages/{placeId}/{userId}/{messageId}/{fileName} {
      // Reads are authorized by the regional getImageAccessUrls callable and
      // served with a short-lived V4 URL. Firebase clients never read objects
      // directly, even when authenticated.
      allow read: if false;

      // `resource == null` is mandatory: Storage Rules do not provide the
      // Firestore-style create/update separation needed for immutability.
      // It prevents an owner from replacing an existing generation.
      allow write: if resource == null
                   && request.auth != null
                   && request.auth.uid == userId
                   && messageId.matches(
                        '^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$'
                      )
                   && fileName.matches(
                        '^[0-3][.]webp$'
                      )
                   && request.resource.size <= 2 * 1024 * 1024
                   && request.resource.contentType == 'image/webp';
    }

    // ── map pin thumbnails ─────────────────────────────────────────────────
    // Path: images/pins/{placeId}/{userId}/{uuidV7}.webp
    // Only generated thumbnails are stored; original images are not retained.
    match /images/pins/{placeId}/{userId}/{fileName} {
      allow read: if false;

      allow write: if resource == null
                   && request.auth != null
                   && request.auth.uid == userId
                   && fileName.matches(
                        '^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}[.]webp$'
                      )
                   && request.resource.size <= 256 * 1024
                   && request.resource.contentType == 'image/webp';
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
