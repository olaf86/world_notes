# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# CocoaPods lock — reproducibility is guaranteed by pubspec.lock + Podfile.
# Flutter plugin pods are path-only (not on CDN trunk), so committing
# Podfile.lock causes checksum mismatches in clean CI environments.
ios/Podfile.lock

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local dart-define overrides (contains API keys)
.dart_define.json

# Claude Code per-user runtime + permission allowlist
.claude/
