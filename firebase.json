{
  "firestore": [
    {
      "database": "(default)",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    },
    {
      "database": "north-america",
      "rules": "firestore.named.locked.rules",
      "indexes": "firestore.indexes.json"
    },
    {
      "database": "europe",
      "rules": "firestore.named.locked.rules",
      "indexes": "firestore.indexes.json"
    }
  ],
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/node_modules/**"],
    "appAssociation": "NONE",
    "rewrites": [
      { "source": "/i/**", "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "/.well-known/apple-app-site-association",
        "headers": [{ "key": "Content-Type", "value": "application/json" }]
      },
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [{ "key": "Content-Type", "value": "application/json" }]
      }
    ]
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "world-notes-prod",
          "appId": "1:260600606826:android:9db9fd461f88cd57fe1a13",
          "fileOutput": "android/app/google-services.json"
        },
        "buildConfigurations": {
          ".": {
            "projectId": "world-notes-prod",
            "appId": "1:260600606826:android:9db9fd461f88cd57fe1a13",
            "fileOutput": "android/app/google-services.json"
          }
        }
      },
      "ios": {
        "default": {
          "projectId": "world-notes-prod",
          "appId": "1:260600606826:ios:bac4b29736a3ef63fe1a13",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        },
        "targets": {
          "Runner": {
            "projectId": "world-notes-prod",
            "appId": "1:260600606826:ios:bac4b29736a3ef63fe1a13",
            "uploadDebugSymbols": true,
            "fileOutput": "ios/Runner/GoogleService-Info.plist"
          }
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "world-notes-prod",
          "configurations": {
            "android": "1:260600606826:android:9db9fd461f88cd57fe1a13",
            "ios": "1:260600606826:ios:bac4b29736a3ef63fe1a13"
          }
        }
      }
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
